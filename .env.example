# BerryLensAI — Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Flask ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_random_secret_key_here

# ── Application settings ───────────────────────────────────────────────────
BERRYLENS_DEMO_MODE=false
# Optional: set to require X-API-Key header on verify endpoints
BERRYLENS_API_KEY=
BERRYLENS_DB_PATH=data/berrylens.db
BERRYLENS_CHROMA_PATH=data/chroma_db
RATE_LIMIT_PER_MINUTE=30
MAX_CLAIM_LENGTH=1000
MAX_QUERIES_PER_CLAIM=3
MAX_RESULTS_PER_QUERY=4
MAX_CACHE_AGE_DAYS=30
# Set to true to enable AI-powered search query expansion (requires HUGGINGFACE_API_KEY)
BERRYLENS_AI_QUERY_EXPANSION=false
# Set to true to disable all LLM calls (use deterministic engine only)
BERRYLENS_DISABLE_LLM=false

# ── LLM providers ──────────────────────────────────────────────────────────
# Provider used first. Options: gemini, groq, deepseek, cerebras
PRIMARY_LLM_PROVIDER=gemini
# Comma-separated fallback chain (empty = auto-detect from available keys)
FALLBACK_LLM_PROVIDERS=groq,deepseek,cerebras
LLM_TIMEOUT_SECONDS=15

# Gemini (Google AI Studio — https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Cerebras (https://cloud.cerebras.ai)
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama3.1-8b

# Hugging Face (optional — only needed for AI query expansion)
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ── Search ─────────────────────────────────────────────────────────────────
# Tavily (https://app.tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here
